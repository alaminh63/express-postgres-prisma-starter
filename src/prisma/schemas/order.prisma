// =====================================================
// ORDER SYSTEM
// =====================================================

model Order {
  id            Int          @id @default(autoincrement())
  orderNumber   String       @unique @map("order_number")
  userId        Int          @map("user_id")
  addressId     Int          @map("address_id")
  couponId      Int?         @map("coupon_id")
  paymentStatus PaymentStatus @map("payment_status")
  orderStatus   OrderStatus  @map("order_status")
  subtotal      Decimal      @db.Decimal(10, 2)
  discountTotal Decimal      @default(0.00) @map("discount_total") @db.Decimal(10, 2)
  deliveryCharge Decimal     @default(0.00) @map("delivery_charge") @db.Decimal(10, 2)
  taxAmount     Decimal      @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount   Decimal      @map("total_amount") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  address         UserAddress         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon          Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  couponUsages    CouponUsage[]
  chatThreads     ChatThread[]
  walletTransactions VendorWalletTransaction[]

  @@index([userId])
  @@index([orderNumber])
  @@index([addressId])
  @@index([couponId])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([createdAt])
  @@map("order")
}

model OrderItem {
  id            Int            @id @default(autoincrement())
  orderId       Int            @map("order_id")
  vendorId      Int            @map("vendor_id")
  variantId     Int            @map("variant_id")
  productId     Int            @map("product_id")
  quantity      Int
  price         Decimal        @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalPrice    Decimal        @map("total_price") @db.Decimal(10, 2)
  itemStatus    OrderItemStatus @map("item_status")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  variant         ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  statusHistory   OrderStatusHistory[]
  returnRequest   ReturnRequest?
  cancelRequest   CancelRequest?
  shipment        Shipment?
  reviews         Review[]
  walletTransactions VendorWalletTransaction[]

  @@index([orderId])
  @@index([vendorId])
  @@index([variantId])
  @@index([productId])
  @@index([itemStatus])
  @@map("order_item")
}

model OrderStatusHistory {
  id          Int      @id @default(autoincrement())
  orderId     Int?     @map("order_id")
  orderItemId Int?     @map("order_item_id")
  status      String
  notes       String?
  changedBy   Int?     @map("changed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  order     Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  changer   User?      @relation("StatusChanger", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_status_history")
}

model ReturnRequest {
  id         Int                 @id @default(autoincrement())
  orderItemId Int                @unique @map("order_item_id")
  reason     String
  status     ReturnRequestStatus
  adminNotes String?             @map("admin_notes")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
  @@map("return_request")
}

model CancelRequest {
  id         Int                @id @default(autoincrement())
  orderItemId Int               @unique @map("order_item_id")
  reason     String
  status     CancelRequestStatus
  adminNotes String?            @map("admin_notes")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
  @@map("cancel_request")
}
