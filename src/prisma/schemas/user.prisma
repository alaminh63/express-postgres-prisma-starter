// =====================================================
// USER & AUTHENTICATION
// =====================================================

model User {
  id           Int       @id @default(autoincrement())
  roleId       Int       @map("role_id")
  name         String
  email        String    @unique
  phone        String    @unique
  passwordHash String    @map("password_hash")
  profileImage String?   @map("profile_image")
  isVerified   Boolean   @default(false) @map("is_verified")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role            Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  addresses       UserAddress[]
  vendor          Vendor?
  cart            Cart?
  wishlist        Wishlist?
  orders          Order[]
  reviews         Review[]
  reviewHelpfuls  ReviewHelpful[]
  notifications   Notification[]
  chatThreads     ChatThread[]
  chatMessages    ChatMessage[]
  couponsCreated  Coupon[]        @relation("CouponCreator")
  couponUsages    CouponUsage[]
  campaigns       Campaign[]      @relation("CampaignCreator")
  auditLogs       AuditLog[]
  adminTeam       AdminTeam?
  searchHistory   SearchHistory[]
  productViews    ProductView[]
  withdrawalRequestsProcessed WithdrawalRequest[] @relation("WithdrawalProcessor")
  statusHistoryChanges OrderStatusHistory[] @relation("StatusChanger")

  @@index([email])
  @@index([phone])
  @@index([roleId])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model Otp {
  id        Int       @id @default(autoincrement())
  phone     String
  otp       String
  purpose   OtpPurpose
  isUsed    Boolean   @default(false) @map("is_used")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([phone, purpose])
  @@index([phone])
  @@index([expiresAt])
  @@map("otp")
}

model UserAddress {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  label       String?
  addressLine String   @map("address_line")
  city        String
  state       String
  country     String   @default("India")
  pincode     String
  phone       String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([userId])
  @@index([isDefault])
  @@map("user_address")
}
